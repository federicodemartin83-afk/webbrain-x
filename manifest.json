{
  "manifest_version": 3,
  "name": "WebBrain X Tracker",
  "version": "0.1.0",
  "description": "Base estensione Chrome per tracciare URL visitati e tempo pagina per WebBrain X.",
  "permissions": [
    "tabs",
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebBrain X Tracker"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}